OPENAI_API_KEY=

# Luna rate limiting (TEA-52). Optional: these are the defaults.
# In production, set them with `supabase secrets set ...`.
LUNA_RATE_LIMIT_MAX_REQUESTS=20
LUNA_RATE_LIMIT_WINDOW_SECONDS=60
# Shared ceiling for all anonymous callers behind one IP address.
# Defaults to 5x LUNA_RATE_LIMIT_MAX_REQUESTS.
# LUNA_RATE_LIMIT_IP_MAX_REQUESTS=100
