# JamSpot mobile (Expo) — copy to .env and fill in.
# Every value here is public: EXPO_PUBLIC_* is embedded in the app bundle and
# readable by anyone who downloads the app. Never put a Supabase service-role
# key, database password, or JWT secret in this file.

# Supabase — the SAME project the web app uses, so an account created on the
# phone signs in on the web with the same email address.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: override which JamSpot API the app talks to. Unset, a dev build
# uses your machine's dev server when one is running and otherwise falls back
# to the deployed app. See apps/mobile/README.md.
# EXPO_PUBLIC_API_URL=http://localhost:3000
