# JamSpot web (Next.js) — copy to .env.local and fill in.
# Every value here is public: NEXT_PUBLIC_* is inlined into the browser bundle.
# Never put a Supabase service-role key, database password, or JWT secret in
# this file or any NEXT_PUBLIC_* variable.

# Public origin, used for canonical URLs, Open Graph tags, the sitemap, and
# JSON-LD on the discovery pages (TEA-67). Must be the PUBLIC domain: a
# canonical pointing at a preview deployment tells crawlers the preview is the
# real page. Defaults to the production deployment when unset.
NEXT_PUBLIC_SITE_URL=https://jamspot-three.vercel.app

# Supabase — the SAME project the mobile app uses, so both share one Auth user
# population. Dashboard > Project Settings > Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Concert and artist providers used by the API routes under app/api.
# Server-side only — no NEXT_PUBLIC_ prefix, so these stay out of the bundle.
TICKETMASTER_API_KEY=
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
